{
  "source_system": "HRMS_A",
  "source_file": "data/hrms_a_day1.csv",
  "mappings": [
    { "target_table": "employee", "target_field": "source_employee_id", "expr": "CAST(Employee_ID AS STRING)" },
    { "target_table": "employee", "target_field": "full_name", "expr": "TRIM(CONCAT(First_Name, ' ', Last_Name))" },
    { "target_table": "employee", "target_field": "email", "expr": "LOWER(TRIM(Work_Email))" },
    { "target_table": "employee", "target_field": "hire_date", "expr": "COALESCE(TO_DATE(Hire_Date, 'MM-dd-yyyy'), TO_DATE(Hire_Date, 'yyyy-MM-dd'), TO_DATE(Hire_Date, 'dd-MM-yyyy'))" },
    { "target_table": "employee", "target_field": "grade", "expr": "UPPER(TRIM(Job_Grade))" },
    { "target_table": "employee", "target_field": "department", "expr": "TRIM(Department)" },
    { "target_table": "employee", "target_field": "location", "expr": "TRIM(Location)" },
    { "target_table": "employee", "target_field": "country", "expr": "TRIM(Country)" },
    { "target_table": "employee", "target_field": "gender", "expr": "LEFT(UPPER(TRIM(Gender)), 1)" },
    { "target_table": "employee", "target_field": "manager_employee_id", "expr": "NULLIF(TRIM(CAST(Manager_ID AS STRING)), '0')" },
    { "target_table": "employee", "target_field": "employment_status", "expr": "TRIM(Employment_Status)" },
    
    { "target_table": "salary", "target_field": "source_employee_id", "expr": "CAST(Employee_ID AS STRING)" },
    { "target_table": "salary", "target_field": "annual_base_local", "expr": "CAST(Annual_Base_Salary AS DECIMAL(18,2))" },
    {
      "target_table": "salary","target_field": "currency", "expr": "CASE WHEN UPPER(TRIM(Currency)) IN ('XXX', '', 'NULL') OR Currency IS NULL THEN CASE WHEN UPPER(TRIM(Country)) = 'INDIA' THEN 'INR' WHEN UPPER(TRIM(Country)) = 'UNITED KINGDOM' THEN 'GBP' WHEN UPPER(TRIM(Country)) = 'UNITED ARAB EMIRATES' THEN 'AED' ELSE 'USD' END ELSE UPPER(TRIM(Currency)) END"
    }
  ],
  "validation_rules": [
    "source_employee_id IS NOT NULL",
    "full_name IS NOT NULL",
    "hire_date IS NOT NULL",
    "hire_date <= CURRENT_DATE()",
    "grade IS NOT NULL",
    "employment_status IS NOT NULL",
    "annual_base_local IS NOT NULL",
    "annual_base_local > 0",
    "currency IS NOT NULL",
    "currency IN ('INR', 'AED', 'USD', 'GBP')"
  ]
}